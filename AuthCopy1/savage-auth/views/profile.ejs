<!doctype html>
<html>
<head>
    <title>21 Savage Fan Site</title>
    <link rel="stylesheet" href="//netdna.bootstrapcdn.com/bootstrap/3.0.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="//netdna.bootstrapcdn.com/font-awesome/4.0.3/css/font-awesome.min.css">
    <link rel="stylesheet" href="style.css">
</head>
<body>
<div class="container">

    <div class="page-header text-center">
        <h1><span class="fa fa-cloud"> </span> Meal Tracker HomePage</h1>
    </div>

    <div class="row">

        <!-- LOCAL INFORMATION -->

      <!-- <div class="col-sm-6">
            <div class="well">
                <h3><span class="fa fa-user"></span> Local</h3>

                <% if (user.local.email) { %>
                    <p>
                        <strong>id</strong>: <%= user._id %><br>
                        <strong>email</strong>: <%= user.local.email %><br>
                        <strong>password</strong>: <%= user.local.password %>
                    </p>

                    <a href="/unlink/local" class="btn btn-default">Unlink</a>
                <% } else { %>
                    <a href="/connect/local" class="btn btn-default">Connect Local</a>
                <% } %> 

            </div>
        </div>
              -->

        <div class="col-sm-6 form">
          <div class="meals">
          <h1>Daily Meals</h1>
          <ul class="messages">
          <% for(var i=0; i<messages.length; i++) {%>
            <li class="message">
              <span><%= messages[i].date %></span>
              <span><%= messages[i].name %></span>
              <span><%= messages[i].msg %></span>
              <span><i class="fa fa-trash" aria-hidden="true"></i></span>
            </li>
          <% } %>
          </ul>
          </div>
          <div class="logs">
          <h1>Log a Meal</h1>
        <% if (user.local.email) { %>
          <form class="logAMeal" action="/messages" method="POST">
            <input type="text" placeholder="Date And Meal (Breakfast,Lunch Or Dinner)" name="date">
            <input type="text" placeholder="Meal" name="name">
            <input type="text" placeholder="Calories" name="msg">
            <button type="submit">Add To List</button>
          </form>
          </div>
        </div>
        <% } %>

</div>
<footer>
  <a href="/logout" class="btn btn-default btn-lg">Logout</a>
</footer>

<script src="main.js"></script>

</body>
</html>
